# Regression test: VLT.8 writes eL with a 3-cycle latency.
# The scheduler must insert at least 2 NOPs between VLT and a dependent VSEL
# to avoid reading stale comparison results. See: color_threshold miscompile.

# RUN: llc -mtriple=aie2p -run-pass=postmisched --issue-limit=1 %s -o - | FileCheck %s

---
name:            vlt8_vsel8_latency
alignment:       16
body:             |
  bb.0.entry:
    liveins: $x0, $x1, $x2, $x4
    ; CHECK-LABEL: name: vlt8_vsel8_latency
    ; CHECK: liveins: $x0, $x1, $x2, $x4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $l0 = VLT_8_vaddSign0 $x0, $x1, implicit $vaddsign0
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: $x2 = VSEL_8 $x2, $x4, $l0
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: NOP
    $l0 = VLT_8_vaddSign0 $x0, $x1, implicit $vaddsign0
    $x2 = VSEL_8 $x2, $x4, $l0
...

